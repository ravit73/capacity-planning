# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────
# The Application (client) ID of your Azure AD app registration
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The Directory (tenant) ID — or "common" for multi-tenant
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set to "false" to disable auth entirely (local dev without Azure AD)
# VITE_AUTH_ENABLED=false
