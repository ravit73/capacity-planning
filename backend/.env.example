# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/capacity_planning

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set to false to disable auth (local dev without Azure AD)
# AUTH_ENABLED=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array format for pydantic-settings)
# CORS_ORIGINS=["http://localhost:5173","https://yourapp.example.com"]
